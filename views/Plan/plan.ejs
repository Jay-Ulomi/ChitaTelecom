<script type="text/javascript">
    (function () {
        var js = document.getElementById("splynx_signup_script");
        if (!js) {
            js = document.createElement("script");
            js.id = "splynx_signup_script";
            js.src = "https://chita.splynx.app/js/development/widgets/signup.js";
            document.body.appendChild(js);
        }

        var p = {
            formTitle: "Signup",
            formButtonText: "Register",
            submitThanks: "Thanks for signing up!",
            required_tariff: 0,
            vat_included: 0,
            partner_id: "1",
            admin_id: "0",
            crm_status: "1",
            location: "1",
            show_form_terms: 0,
            form_terms_template: "99",
            required_first_name: 1,
            required_last_name: 0,
            required_email: 1,
            required_phone: 1,
            required_street: 0,
            required_city: 0,
            required_zip: 0,
            queryString: "formTitle=Signup&formButtonText=Register&submitThanks=Thanks%20for%20signing%20up!&required_tariff=0&vat_included=0&partner_id=1&admin_id=0&crm_status=1&location=1&show_form_terms=0&form_terms_template=99&required_first_name=1&required_last_name=0&required_email=1&required_phone=1&required_street=0&required_city=0&required_zip=0",
            url: "https://chita.splynx.app",
            scriptUrl: "https://chita.splynx.app/js/development/widgets/signup.js"
        };

        if (typeof SplynxSignUpWidget === "undefined") {
            js.addEventListener("load", function () {
                SplynxSignUpWidget.init(p);
            });
        } else {
            SplynxSignUpWidget.init(p);
        }
    })();

    document.addEventListener("DOMContentLoaded", function () {
        var selectedPlan = document.getElementById("splynxSelectedPlan");
        var signupButtons = document.querySelectorAll(".signup-trigger");
        var modalElement = document.getElementById("splynxSignupModal");
        var urlParams = new URLSearchParams(window.location.search);

        signupButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                var planName = button.getAttribute("data-plan-name") || "ChitaTelecom plan";
                selectedPlan.textContent = "Selected package: " + planName;
            });
        });

        if (modalElement && urlParams.get("signup") === "1") {
            var requestedPlan = urlParams.get("plan") || "ChitaTelecom plan";
            selectedPlan.textContent = "Selected package: " + decodeURIComponent(requestedPlan);
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        }
    });
</script>

